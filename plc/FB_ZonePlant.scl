FUNCTION_BLOCK "FB_ZonePlant"
TITLE = Simulated TCU zone (plant model for PLCSIM tests)
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : chad416
VERSION : 0.2
//  Same two-mass model as src/tcutune/plant.py (no noise), explicit Euler.
//  Cooling: HxUA > 0 -> plate exchanger, Pc = eps*Cmin*(Tw - Tcw) with the valve
//  characteristic in front (same as tcutune.physics); HxUA = 0 -> direct cooling,
//  Pc = Cool/100 * Kcool * (Tw - Tcw).  Defaults are zone A of tcutune.plant.PRESETS.
//  Lets FB_ZonePID run in a closed loop inside S7-PLCSIM without hardware.
//  Simulation only: never call this block in a real machine program.
   VAR_INPUT
      Heat : Real;   // % heater
      Cool : Real;   // % cooling valve
      Qproc : Real;   // kW, process heat into the machine part
      Init : Bool;   // TRUE: set both temperatures and the delay line to InitTemp
      InitTemp : Real := 25.0;   // degC
      Cw : Real := 76.75;   // kJ/K
      Cm : Real := 147.2;   // kJ/K
      UAwm : Real := 1.142;   // kW/K
      UAloss : Real := 0.0399;   // kW/K
      PheatMax : Real := 12.0;   // kW
      Kcool : Real := 0.0;   // kW/K at 100 % valve (direct cooling only)
      HxUA : Real := 0.9;   // kW/K, plate exchanger UA at full cooling flow (0 = direct)
      CsMax : Real := 1.391;   // kW/K, cooling-water capacity rate at full flow
      Cp : Real := 2.719;   // kW/K, primary capacity rate
      ValveR : Real := 0.0;   // 0 linear, > 1 equal-percentage
      Tcw : Real := 15.0;   // degC
      Tamb : Real := 25.0;   // degC
      DelaySamples : Int := 77;   // dead time / CycleTime, 1..300
      TauSensor : Real := 4.0;   // s
      SensorOnMetal : Bool;   // FALSE: water temperature, TRUE: machine part
      CycleTime : Real := 0.1;   // s
   END_VAR

   VAR_OUTPUT
      Pv : Real;   // measured temperature, degC
      Tw : Real;   // water temperature, degC
      Tm : Real;   // machine part temperature, degC
   END_VAR

   VAR
      sTw : Real := 25.0;
      sTm : Real := 25.0;
      sSensor : Real := 25.0;
      sDelay : Array[0..299] of Real;
      sIdx : Int;
   END_VAR

   VAR_TEMP
      tHeat : Real;
      tCool : Real;
      tPh : Real;
      tPc : Real;
      tDTw : Real;
      tDTm : Real;
      tRaw : Real;
      tDelayed : Real;
      tF : Real;
      tHAp : Real;
      tHAs : Real;
      tUA : Real;
      tCs : Real;
      tCmin : Real;
      tCmax : Real;
      tE : Real;
      tCr : Real;
      tG : Real;
      tN : Int;
      i : Int;
   END_VAR


BEGIN
	REGION Init
	    #tN := LIMIT(MN := 1, IN := #DelaySamples, MX := 300);
	    IF #Init THEN
	        #sTw := #InitTemp;
	        #sTm := #InitTemp;
	        #sSensor := #InitTemp;
	        FOR #i := 0 TO 299 DO
	            #sDelay[#i] := #InitTemp;
	        END_FOR;
	        #sIdx := 0;
	    END_IF;
	END_REGION

	REGION Model
	    #tHeat := LIMIT(MN := 0.0, IN := #Heat, MX := 100.0);
	    #tCool := LIMIT(MN := 0.0, IN := #Cool, MX := 100.0);
	    #tPh := #tHeat / 100.0 * #PheatMax;
	    IF #HxUA > 0.0 THEN
	        IF #ValveR > 1.0 THEN
	            #tF := (EXP(LN(#ValveR) * (#tCool / 100.0 - 1.0)) - 1.0 / #ValveR) / (1.0 - 1.0 / #ValveR);
	        ELSE
	            #tF := #tCool / 100.0;
	        END_IF;
	        IF #tF <= 0.000001 THEN
	            #tG := 0.0;
	        ELSE
	            #tHAp := 2.0 * #HxUA;
	            #tHAs := 2.0 * #HxUA * EXP(0.8 * LN(#tF));
	            #tUA := #tHAp * #tHAs / (#tHAp + #tHAs);
	            #tCs := #tF * #CsMax;
	            #tCmin := MIN(IN1 := #tCs, IN2 := #Cp);
	            #tCmax := MAX(IN1 := #tCs, IN2 := #Cp);
	            #tCr := #tCmin / #tCmax;
	            IF ABS(1.0 - #tCr) < 0.0001 THEN
	                #tE := #tUA / #tCmin / (1.0 + #tUA / #tCmin);
	            ELSE
	                #tE := EXP(-#tUA / #tCmin * (1.0 - #tCr));
	                #tE := (1.0 - #tE) / (1.0 - #tCr * #tE);
	            END_IF;
	            #tG := #tE * #tCmin;
	        END_IF;
	    ELSE
	        #tG := #tCool / 100.0 * #Kcool;
	    END_IF;
	    #tPc := #tG * MAX(IN1 := #sTw - #Tcw, IN2 := 0.0);
	    #tDTw := (#tPh - #tPc + #UAwm * (#sTm - #sTw)) / #Cw;
	    #tDTm := (#UAwm * (#sTw - #sTm) - #UAloss * (#sTm - #Tamb) + #Qproc) / #Cm;
	    #sTw := #sTw + #CycleTime * #tDTw;
	    #sTm := #sTm + #CycleTime * #tDTm;
	END_REGION

	REGION Sensor
	    IF #SensorOnMetal THEN
	        #tRaw := #sTm;
	    ELSE
	        #tRaw := #sTw;
	    END_IF;
	    IF #sIdx >= #tN THEN
	        #sIdx := 0;
	    END_IF;
	    #tDelayed := #sDelay[#sIdx];
	    #sDelay[#sIdx] := #tRaw;
	    #sIdx := #sIdx + 1;
	    IF #sIdx >= #tN THEN
	        #sIdx := 0;
	    END_IF;
	    #sSensor := #sSensor + #CycleTime / (#TauSensor + #CycleTime) * (#tDelayed - #sSensor);
	END_REGION

	#Pv := #sSensor;
	#Tw := #sTw;
	#Tm := #sTm;
END_FUNCTION_BLOCK
