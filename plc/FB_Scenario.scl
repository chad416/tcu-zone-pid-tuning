FUNCTION_BLOCK "FB_Scenario"
TITLE = Test profile for one zone: cold start, setpoint steps, process load on/off
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : chad416
VERSION : 0.1
//  Same profile as tcutune.experiments.production_scenario().
//  Times are counted in calls (CycleTime each), so the profile is exact in PLCSIM.
   VAR_INPUT
      Restart : Bool;   // TRUE: time back to 0
      CycleTime : Real := 0.1;   // s
      SpStart : Real := 70.0;   // degC, from t = 0 (cold start)
      SpHigh : Real := 80.0;   // degC, from tSpHigh
      SpLow : Real := 75.0;   // degC, from tSpLow
      Qrun : Real := 9.0;   // kW process heat while the machine runs
      tSpHigh : Real := 3000.0;   // s
      tLoadOn : Real := 5400.0;   // s
      tSpLow : Real := 8400.0;   // s
      tLoadOff : Real := 10200.0;   // s
      tEnd : Real := 12000.0;   // s
   END_VAR

   VAR_OUTPUT
      Setpoint : Real;   // degC
      Qproc : Real;   // kW
      ElapsedS : Real;   // s since restart
      Done : Bool;   // TRUE once tEnd is reached
   END_VAR

   VAR
      sCount : DInt;
   END_VAR


BEGIN
	IF #Restart THEN
	    #sCount := 0;
	END_IF;

	#ElapsedS := DINT_TO_REAL(#sCount) * #CycleTime;

	IF #ElapsedS >= #tSpLow THEN
	    #Setpoint := #SpLow;
	ELSIF #ElapsedS >= #tSpHigh THEN
	    #Setpoint := #SpHigh;
	ELSE
	    #Setpoint := #SpStart;
	END_IF;

	IF #ElapsedS >= #tLoadOn AND #ElapsedS < #tLoadOff THEN
	    #Qproc := #Qrun;
	ELSE
	    #Qproc := 0.0;
	END_IF;

	IF #ElapsedS < #tEnd THEN
	    #sCount := #sCount + 1;
	    #Done := FALSE;
	ELSE
	    #Done := TRUE;
	END_IF;
END_FUNCTION_BLOCK
